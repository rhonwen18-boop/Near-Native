 {name:'Amelia M.',country:'South Africa',city:'London',languages:['English'],interests:['Travel'],intro:'South African living in London.',avatar:'AM'},
 {name:'Thabo K.',country:'South Africa',city:'London',languages:['English'],interests:['Sport'],intro:'South African in London who loves sport.',avatar:'TK'},
