    if(s16){const old=s16.querySelector('#sentMessage');if(old)old.remove();const card=s16.querySelector('.card');if(card)card.innerHTML='<strong>Conversation</strong><p class="sub">Messages are synced through your Near-Native account.</p>'}
  }

  const oldGo=window.go;
  window.go=function(n){
    const r=oldGo.apply(this,arguments);
    if(n===10)setTimeout(()=>{nnCommunityDiscoverLink();nnLoadPeople()},80);
    if(n===15)setTimeout(()=>nnLoadMessages(),100);
    if(n===16)setTimeout(()=>nnLoadChatMessages(),100);
    return r;
  };
  const oldSave=window.saveState;
  window.saveState=function(){const r=oldSave.apply(this,arguments);setTimeout(()=>nnSyncProfile().catch(()=>{}),80);return r};
  const oldSetCity=window.setCity;
  window.setCity=function(name){const r=oldSetCity.apply(this,arguments);setTimeout(()=>nnSyncProfile().catch(()=>{}),100);return r};
  const oldSelectRemoteCity=window.selectRemoteCity;
  window.selectRemoteCity=function(i){const r=oldSelectRemoteCity.apply(this,arguments);setTimeout(()=>nnSyncProfile().catch(()=>{}),100);return r};

  document.addEventListener('DOMContentLoaded',async function(){
    nnPrepareScreens();nnCommunityDiscoverLink();nnInstallPeopleClickHandler();
    try{
      const u=await nnUser();
      if(u){await nnHydrateProfile(u);await nnEnsureProfileForCurrentUser(u);restoreState();updatePersonalisedUI();}
    }catch(e){console.warn('Near-Native V2.6 startup profile sync failed',e)}
  });
})();

/* V2.5.6 location fix */
async function useMyLocation(){
  const status=document.getElementById('locationStatus')||document.getElementById('onboardingCityStatus');
  const btn=document.getElementById('useLocationBtn')||[...document.querySelectorAll('#s4 .btn')].find(x=>/Use My Location/i.test(x.textContent||''));
  const finish=(msg,ok=false)=>{
    if(status){status.textContent=msg;status.style.color=ok?'#17A398':'';}
    if(btn){btn.disabled=false;btn.textContent='📍 Use My Location';}
  };
  if(status)status.textContent='📍 Finding your city…';
  if(btn){btn.disabled=true;btn.textContent='Finding your city…';}

  const apply=(c,co)=>{
    c=String(c||'').trim(); co=String(co||'').trim();
    if(!c)throw new Error('No city found');
    city=c;
    if(co)country=co;
    saveState();
    updatePersonalisedUI();
    finish('📍 Location found: '+city+(co?' · '+co:''),true);
    setTimeout(()=>go(5),500);
  };

  // 1) Try browser GPS. This works reliably when the app is served over HTTPS
  // (for example through GitHub Pages) and the user grants Chrome permission.
  if(navigator.geolocation){
    try{
      if(status)status.textContent='📍 Requesting Chrome location permission…';
      const pos=await new Promise((resolve,reject)=>navigator.geolocation.getCurrentPosition(resolve,reject,{
        enableHighAccuracy:false,timeout:10000,maximumAge:300000
      }));
      const lat=pos.coords.latitude,lon=pos.coords.longitude;
      const r=await fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat='+encodeURIComponent(lat)+'&lon='+encodeURIComponent(lon)+'&zoom=10&addressdetails=1',{cache:'no-store'});
      if(!r.ok)throw new Error('Reverse geocoding failed');
      const d=await r.json();
      const a=d.address||{};
      const detected=String(a.city||a.town||a.municipality||a.village||a.suburb||'').trim();
      const co=String(a.country||'').trim();
      if(!detected)throw new Error('No city found');
      apply(detected,co); return;
    }catch(e){
      // Continue to the approximate IP fallback.
    }
  }

  // 2) IP fallback. This also works when the HTML is opened locally.
  try{
    if(status)status.textContent='📍 Finding your approximate city…';
    const r=await fetch('https://ipapi.co/json/?t='+Date.now(),{cache:'no-store'});
    if(!r.ok)throw new Error('IP location failed');
    const d=await r.json();
    const detected=String(d.city||d.region||'').trim();
    if(!detected)throw new Error('No city found');
    apply(detected,String(d.country_name||'').trim());
  }catch(e){
    finish('Location could not be detected. Please allow Chrome location access or choose your city manually.');
  }
}
