      const host=document.createElement('div');host.id='messagesList';host.className='message-list';s15.querySelector('.nav')?.before(host);
      const status=document.getElementById('messageSyncStatus');if(status)status.textContent='Messages are stored in your Near-Native Supabase account.';
    }
