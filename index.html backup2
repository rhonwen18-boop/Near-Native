function nnNorm(v){return String(v||'').trim().toLowerCase()}
function nnMatches(p,filters){
 const city=nnNorm(filters.city), country=nnNorm(filters.country), lang=nnNorm(filters.language), interest=nnNorm(filters.interest);
 return (!city||nnNorm(p.city)===city) && (!country||nnNorm(p.country)===country) && (!lang||((p.languages||[]).some(x=>nnNorm(x)===lang))) && (!interest||((p.interests||[]).some(x=>nnNorm(x)===interest)));
}
function nnScorePerson(p,me){
 let score=0;
 const myCity=nnNorm(me.city), myCountry=nnNorm(me.country);
 const myLanguages=(me.languages||[]).map(nnNorm).filter(Boolean);
 const myInterests=(me.interests||[]).map(nnNorm).filter(Boolean);
 if(myCity && nnNorm(p.city)===myCity) score+=50;
 if(myCountry && nnNorm(p.country)===myCountry) score+=25;
 score+=(p.languages||[]).map(nnNorm).filter(x=>myLanguages.includes(x)).length*15;
 score+=(p.interests||[]).map(nnNorm).filter(x=>myInterests.includes(x)).length*8;
 return score;
}
function nnDiscoverPeople(){
 const me=nnGetProfile()||{};
 return NN_DEMO_USERS.filter(u=>u.name!==me.name).map(u=>({user:u,score:nnScorePerson(u,me)})).filter(x=>x.score>0).sort((a,b)=>b.score-a.score).map(x=>x.user);
}
