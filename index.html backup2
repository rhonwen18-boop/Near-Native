<script>
/* Near-Native V2.5.4 — Supabase community/city system
   Dynamic community cards are keyed by the actual community row, never by the old London demo screen. */
(function(){
  const esc = v => (typeof escapeHtml==='function' ? escapeHtml(v) : String(v??''));
  let nnCommunityCache=[];
  let nnCurrentCommunity=null;

  function nnProfile(){
    try{return JSON.parse(localStorage.getItem('nearNativeProfile')||'{}')}catch(e){return {}}
  }
  function nnCurrentCity(){ return String(nnProfile().city || city || '').trim(); }
  function nnCurrentCountry(){ return String(nnProfile().country || country || '').trim(); }
  function nnCommunityFallback(){
    const c=nnCurrentCity(), co=nnCurrentCountry();
    if(!c) return null;
    return {id:null,name:(co==='South Africa'?'South Africans':'People from '+co)+' in '+c,country:co,city:c,description:'A place to meet, share and stay connected.',virtual:true};
  }
  function nnCommunityCard(c){
    const payload=encodeURIComponent(JSON.stringify(c));
    const icon=c.country==='South Africa'?'🇿🇦':'🌍';
    return '<div class="community community-item" data-community="'+esc(c.name.toLowerCase())+'" data-community-payload="'+payload+'" onclick="nnOpenCommunityFromCard(this)">'
      +'<div class="icon">'+icon+'</div><div><strong>'+esc(c.name)+'</strong>'
      +'<div class="small">'+esc(c.city||'')+(c.country?' · '+esc(c.country):'')+'</div>'
      +'</div></div>';
  }
  window.nnOpenCommunityFromCard=function(el){
    try{
      const raw=el?.getAttribute('data-community-payload')||'';
      if(!raw)throw new Error('Community data is missing.');
      const c=JSON.parse(decodeURIComponent(raw));
      nnOpenCommunity(c);
    }catch(e){
      console.error('Near-Native community card error:',e);
      alert('Could not open this community. Please try again.');
    }
  };
  window.nnOpenCommunity=function(c){
    nnCurrentCommunity=c;
    const s=document.getElementById('s13'); if(!s)return;
    const title=s.querySelector('h1'); if(title)title.textContent=c.name||'Community';
    const sub=s.querySelector('.sub'); if(sub)sub.textContent=c.description||'A place to meet, share and stay connected.';
    const hero=s.querySelector('.hero-card'); if(hero)hero.innerHTML='<strong>'+(c.city?esc(c.city):'Local community')+'</strong><p class="sub">'+esc(c.country||'')+'</p>';
    let b=document.getElementById('joinBtn');
    if(!b){ b=document.createElement('button'); b.id='joinBtn'; b.className='btn primary'; s.appendChild(b); }
    b.textContent='Join Community'; b.disabled=false; b.style.opacity=''; b.onclick=function(){nnJoinCommunity(c,b)};
    s.querySelector('.back')?.setAttribute('onclick','go(12)');
    go(13);
    nnRestoreJoin(c,b);
  };
  async function nnJoinCommunity(c,b){
    if(!c)return;
    b=b||document.getElementById('joinBtn');
    const originalText=b?.textContent||'Join Community';
    try{
      if(b){b.disabled=true;b.textContent='Joining…';}
      let {data:{session}}=await supabaseClient.auth.getSession();
      let user=session?.user||null;

      // Some local-file Android Chrome sessions keep the app's local profile
      // while the Supabase auth session has expired. Re-authenticate in place
      // instead of incorrectly treating the profile as signed in.
      if(!user){
        const savedEmail=localStorage.getItem('nearNativeEmail')||'';
        const email=prompt('Please sign in to join this community.\n\nEmail:',savedEmail);
        if(!email){if(b){b.disabled=false;b.textContent=originalText;}return;}
        const password=prompt('Enter your Near-Native password:');
        if(!password){if(b){b.disabled=false;b.textContent=originalText;}return;}
        const result=await supabaseClient.auth.signInWithPassword({email:email.trim(),password});
        if(result.error)throw result.error;
        user=result.data?.user||null;
        if(user){
          localStorage.setItem('nearNativeAuth','true');
          localStorage.setItem('nearNativeEmail',email.trim());
        }
      }
      if(!user) throw new Error('We could not sign you in. Please try again.');

      // If the city community does not exist yet, create it from the
      // currently selected country/city so the first join creates a real row.
      if(!c.id){
        const name=c.name||'Community';
        const {data:existing,error:findError}=await supabaseClient
          .from('communities').select('id,name,country,city,description,created_at')
          .ilike('name',name).limit(1).maybeSingle();
        if(findError)throw findError;
        if(existing){
          c=existing;
          nnCurrentCommunity=c;
        }else{
          const created=await supabaseClient.from('communities').insert({
            name,
            country:c.country||nnCurrentCountry(),
            city:c.city||nnCurrentCity(),
            description:c.description||'A place to meet, share and stay connected.'
          }).select('id,name,country,city,description,created_at').single();
          if(created.error)throw created.error;
          c=created.data;
          nnCurrentCommunity=c;
        }
      }

      const {error}=await supabaseClient.from('community_members').insert({community_id:c.id,profile_id:user.id});
      if(error && !String(error.message||'').toLowerCase().includes('duplicate') && error.code!=='23505') throw error;
      localStorage.setItem('nearNativeJoined_'+String(c.id),'true');
      if(b){b.textContent='Joined ✓';b.disabled=true;b.style.opacity='.75';}
      // If this was a virtual community, it now has a real Supabase id.
      // Refresh the community list so the new row is immediately visible
      // and future opens use the database record.
      nnCommunityCache = nnCommunityCache.filter(x=>x.id!==c.id);
      nnCommunityCache.push(c);
      if(typeof window.nnLoadCommunities==='function' && document.getElementById('s12')?.classList.contains('active')){
        setTimeout(()=>window.nnLoadCommunities(),80);
      }
    }catch(e){
      if(b){b.disabled=false;b.textContent=originalText;}
      alert(e.message||'Could not join this community.');
    }
  }
  window.nnJoinCommunity=nnJoinCommunity;
  function nnRestoreJoin(c,b){
    if(!b)return;
    const key=c?.id?'nearNativeJoined_'+c.id:'nearNativeJoined_'+String(c?.name||'').toLowerCase().replace(/[^a-z0-9]+/g,'_');
    if(localStorage.getItem(key)==='true'){b.textContent='Joined ✓';b.disabled=true;b.style.opacity='.75';}
  }
  window.nnLoadCommunities=async function(){
    const host=document.getElementById('communityList');
    if(!host)return;
    host.innerHTML='<div class="card"><strong>Loading communities…</strong><p class="sub">Finding communities for your city.</p></div>';
    try{
      const {data,error}=await supabaseClient.from('communities').select('id,name,country,city,description,created_at').order('created_at',{ascending:true});
      if(error)throw error;
      nnCommunityCache=data||[];
      const c=nnCurrentCity(), co=nnCurrentCountry();
      const local=(data||[]).filter(x=>String(x.city||'').toLowerCase()===c.toLowerCase());
      const fallback=nnCommunityFallback();
      const items=[...local];
      if(fallback && !items.some(x=>String(x.name).toLowerCase()===fallback.name.toLowerCase())) items.unshift(fallback);
      const others=(data||[]).filter(x=>!items.some(y=>y.id===x.id));
      host.innerHTML=(items.length?items.map(nnCommunityCard).join(''):'')+(others.length?'<div class="section-title" style="margin-top:18px">Other communities</div>'+others.map(nnCommunityCard).join(''):'');
      if(!items.length&&!others.length) host.innerHTML='<div class="card"><strong>No communities yet</strong><p class="sub">Create a community in Supabase and it will appear here.</p></div>';
    }catch(e){
      const fallback=nnCommunityFallback();
      host.innerHTML=fallback?nnCommunityCard(fallback):'<div class="card"><strong>Communities unavailable</strong><p class="sub">Please check your connection and try again.</p></div>';
    }
    const q=(document.getElementById('communitySearch')?.value||'').toLowerCase().trim();
    if(q) filterCommunities();
  };
  window.filterCommunities=function(){
    const q=(document.getElementById('communitySearch')?.value||'').toLowerCase().trim();
    document.querySelectorAll('#communityList .community-item').forEach(x=>x.style.display=(!q||x.dataset.community.includes(q))?'flex':'none');
  };
  function nnPrepareCommunityScreen(){
    const s=document.getElementById('s12'); if(!s)return;
    const old=s.querySelectorAll('.community-item'); old.forEach(x=>x.remove());
    let host=document.getElementById('communityList');
    if(!host){
      host=document.createElement('div'); host.id='communityList';
      const search=document.getElementById('communitySearch');
      search?.parentNode.insertBefore(host,search.nextSibling);
    }
    const title=s.querySelector('h1'); if(title)title.textContent='Find your communities';
  }
  function nnUpdateDiscoverCommunity(){
    const el=document.getElementById('discoverCommunity'); if(!el)return;
    const c=nnCommunityFallback();
    if(c){el.textContent=c.name;const card=el.closest('.community');if(card)card.onclick=function(){nnOpenCommunity(c)}}
  }
  const originalGo=window.go;
  window.go=function(n){
    const r=originalGo.apply(this,arguments);
    if(n===10){setTimeout(nnUpdateDiscoverCommunity,40);}
    if(n===12){setTimeout(function(){nnPrepareCommunityScreen();nnLoadCommunities();},40);}
    return r;
  };
  const originalSetCity=window.setCity;
  window.setCity=function(name){const r=originalSetCity.apply(this,arguments);setTimeout(nnUpdateDiscoverCommunity,30);return r;};
  const originalSelectRemoteCity=window.selectRemoteCity;
  window.selectRemoteCity=function(i){const r=originalSelectRemoteCity.apply(this,arguments);setTimeout(nnUpdateDiscoverCommunity,50);return r;};
  document.addEventListener('DOMContentLoaded',function(){
    nnPrepareCommunityScreen();
    nnUpdateDiscoverCommunity();
  });
})();
</script>

<script>
/* ===== Near-Native V2.5.5 — Supabase-first people, connections & messaging ===== */
(function(){
  const esc=v=>(typeof escapeHtml==='function'?escapeHtml(v):String(v??''));
  const norm=v=>String(v??'').trim().toLowerCase();
  let nnPeopleCache=[];
  let nnSelectedPerson=null;
  let nnChatConversationId=null;

  // V2.6 account/profile integrity helpers. These are exposed globally because
  // account creation and sign-in are defined earlier in the HTML.
  async function nnHydrateProfile(user){
    const u=user||await nnUser(); if(!u)return null;
    try{
      const r=await supabaseClient.from('profiles').select('id,first_name,last_name,country,current_city,bio,profile_photo_url').eq('id',u.id).maybeSingle();
      if(r.error) throw r.error;
      if(r.data){
        const existing=JSON.parse(localStorage.getItem('nearNativeProfile')||'{}');
        const p={...existing,country:r.data.country||'',city:r.data.current_city||'',name:[r.data.first_name,r.data.last_name].filter(Boolean).join(' ')||u.user_metadata?.first_name||existing.name||'',intro:r.data.bio||''};
        if(r.data.profile_photo_url)p.photo=r.data.profile_photo_url;
        localStorage.setItem('nearNativeProfile',JSON.stringify(p));
        Object.assign(state,p); country=p.country; city=p.city;
        return p;
      }
    }catch(e){console.warn('Near-Native profile hydrate failed',e)}
    return null;
  }

  async function nnEnsureProfileForCurrentUser(user,overrides={}){
    const u=user||await nnUser(); if(!u)return null;
    const p=nnProfile(); const displayName=String(overrides.first_name||p.name||u.user_metadata?.first_name||'').trim();
    const n=nnNameParts(displayName);
    const row={id:u.id,first_name:n.first_name,last_name:n.last_name,country:p.country||'',current_city:p.city||'',bio:p.intro||''};
    if(p.photo && String(p.photo).startsWith('http'))row.profile_photo_url=p.photo;
    const r=await supabaseClient.from('profiles').upsert(row,{onConflict:'id'}).select().single();
    if(r.error) throw r.error;
    return r.data;
  }

  window.nnHydrateProfile=nnHydrateProfile;
  window.nnEnsureProfileForCurrentUser=nnEnsureProfileForCurrentUser;

  function nnProfile(){try{return JSON.parse(localStorage.getItem('nearNativeProfile')||'{}')}catch(e){return {}}}
  async function nnUser(){try{const r=await supabaseClient.auth.getSession();return r?.data?.session?.user||null}catch(e){return null}}
  function nnNameParts(name){
    const parts=String(name||'').trim().split(/\s+/).filter(Boolean);
    return {first_name:parts.shift()||'',last_name:parts.join(' ')||''};
  }
  async function nnSyncProfile(){
    return nnEnsureProfileForCurrentUser();
  }
  async function nnLoadPeople(){
    const host=document.getElementById('peopleList'); if(!host)return;
    host.innerHTML='<div class="card"><strong>Finding your people…</strong><p class="sub">Loading profiles from Near-Native.</p></div>';
    try{
      const me=await nnUser(); if(!me) throw new Error('Please sign in to discover people.');
      const r=await supabaseClient.from('profiles').select('id,first_name,last_name,country,current_city,bio,profile_photo_url,what_you_want,created_at').neq('id',me.id).order('created_at',{ascending:true});
      if(r.error)throw r.error;
      const rows=r.data||[];
      nnPeopleCache=rows.map(x=>({
        id:x.id,name:[x.first_name,x.last_name].filter(Boolean).join(' ')||'Near-Native member',
        country:x.country||'',city:x.current_city||'',intro:x.bio||'',photo:x.profile_photo_url||'',what:x.what_you_want||''
      }));
      await nnLoadAttributes(nnPeopleCache);
      nnRenderPeople();
    }catch(e){
      nnPeopleCache=[];
      host.innerHTML='<div class="card"><strong>We could not load people yet.</strong><p class="sub" style="margin:6px 0 0">'+esc(e.message||'Please check your connection and try again.')+'</p></div>';
    }
  }
  async function nnLoadAttributes(people){
    if(!people.length)return;
    try{
      const ids=people.map(p=>p.id);
      const lr=await supabaseClient.from('profile_languages').select('profile_id,language_id,languages(name)').in('profile_id',ids);
      if(!lr.error)(lr.data||[]).forEach(x=>{const p=people.find(y=>y.id===x.profile_id);const n=x.languages?.name;if(p&&n)(p.languages||(p.languages=[])).push(n)});
    }catch(e){}
    try{
      const ids=people.map(p=>p.id);
      const ir=await supabaseClient.from('profile_interests').select('profile_id,interest_id,interests(name)').in('profile_id',ids);
      if(!ir.error)(ir.data||[]).forEach(x=>{const p=people.find(y=>y.id===x.profile_id);const n=x.interests?.name;if(p&&n)(p.interests||(p.interests=[])).push(n)});
    }catch(e){}
  }
  function nnRenderPeople(){
    const host=document.getElementById('peopleList'); if(!host)return;
    if(!nnPeopleCache.length){
      host.innerHTML='<div class="card nn-empty"><div style="font-size:28px">🌍</div><strong>Your people will appear here</strong><p class="sub" style="margin:6px 0 0">No other Near-Native profiles are registered yet. As people join, they will appear here automatically.</p></div>';
      return;
    }
    host.innerHTML=nnPeopleCache.map(p=>{
      const langs=(p.languages||[]).join(' · '), ints=(p.interests||[]).join(' · ');
      const initials=esc((p.name||'NN').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase());
      const photo=p.photo&&String(p.photo).startsWith('http')?'<img src="'+esc(p.photo)+'" alt="">':'<span class="avatar-initials">'+initials+'</span>';
      return '<div class="person discover-person" data-id="'+esc(p.id)+'" data-name="'+esc(norm(p.name))+'" data-city="'+esc(norm(p.city))+'" data-country="'+esc(norm(p.country))+'" data-language="'+esc(norm(langs))+'" data-interest="'+esc(norm(ints))+'"><div class="avatar">'+photo+'</div><div style="flex:1"><strong style="cursor:pointer">'+esc(p.name)+'</strong><div class="small">🌍 '+esc(p.country||'')+' · 📍 '+esc(p.city||'')+'</div><div class="small">'+esc(langs||'Languages not added yet')+(ints?' · '+esc(ints):'')+'</div></div><button type="button" class="btn primary nn-v25-connect">View</button></div>';
    }).join('');
    nnApplyPeopleFilters();
    nnInstallPeopleClickHandler();
  }
  function nnApplyPeopleFilters(){
    const q=norm(document.getElementById('peopleSearch')?.value||'');
    const me=nnProfile(); const myCity=norm(me.city||city), myCountry=norm(me.country||country);
    const langs=(me.languages||[]).map(norm), ints=(me.interests||[]).map(norm);
    document.querySelectorAll('#peopleList .discover-person').forEach(x=>{
      const search=!q||x.dataset.name.includes(q)||x.dataset.city.includes(q)||x.dataset.country.includes(q)||x.dataset.language.includes(q)||x.dataset.interest.includes(q);
      let f=true;
      if(peopleFilter==='city')f=!!myCity&&x.dataset.city===myCity;
      else if(peopleFilter==='country')f=!!myCountry&&x.dataset.country===myCountry;
      else if(peopleFilter==='language')f=langs.some(v=>v&&x.dataset.language.includes(v));
      else if(peopleFilter==='interest')f=ints.some(v=>v&&x.dataset.interest.includes(v));
      x.style.display=search&&f?'flex':'none';
    });
  }
  window.filterPeople=nnApplyPeopleFilters;
  window.setPeopleFilter=function(f,el){
    peopleFilter=f; document.querySelectorAll('#s10 .row .pill').forEach(x=>x.classList.remove('selected')); if(el)el.classList.add('selected'); nnApplyPeopleFilters();
  };

  // V2.6.2 People click fix: use event delegation instead of inline onclick.
  // The previous HTML embedded a JSON string inside a double-quoted onclick attribute,
  // which can break the attribute and result in a tap doing nothing.
  function nnInstallPeopleClickHandler(){
    const host=document.getElementById('peopleList');
    if(!host || host.dataset.nnPeopleClickBound==='1')return;
    host.dataset.nnPeopleClickBound='1';
    host.addEventListener('click',function(event){
      const card=event.target.closest('#peopleList .discover-person');
      if(!card || !host.contains(card))return;
      const id=card.getAttribute('data-id');
      if(!id)return;
      event.preventDefault();
      event.stopPropagation();
      Promise.resolve(window.nnOpenPersonById(id)).catch(function(err){
        console.error('Near-Native profile click failed',err);
        alert('Could not open this profile: '+(err&&err.message?err.message:String(err)));
      });
    });
  }
  window.nnInstallPeopleClickHandler=nnInstallPeopleClickHandler;

  window.nnOpenPersonById=async function(id){
    /* V2.6.1: robust People-card navigation. Resolve from cache first, then Supabase. */
    const wanted=String(id||'').trim();
    let p=nnPeopleCache.find(x=>String(x.id||'').trim()===wanted);
    if(!p){
      try{
        const r=await supabaseClient.from('profiles').select('id,first_name,last_name,country,current_city,bio,profile_photo_url,what_you_want').eq('id',wanted).single();
        if(r.error)throw r.error;
        const x=r.data;
        p={id:x.id,name:[x.first_name,x.last_name].filter(Boolean).join(' ')||'Near-Native member',country:x.country||'',city:x.current_city||'',intro:x.bio||'',photo:x.profile_photo_url||'',what:x.what_you_want||''};
        nnPeopleCache.push(p);
      }catch(e){
        alert(e.message||'Could not open this profile. Please try again.');
        return;
      }
    }
    nnSelectedPerson=p; localStorage.setItem('nearNativePersonId',String(p.id)); localStorage.setItem('nearNativePerson',p.name);
    const av=document.getElementById('otherProfileAvatar');
    if(av)av.innerHTML=p.photo&&String(p.photo).startsWith('http')?'<img src="'+esc(p.photo)+'" alt="">':'<span class="avatar-initials">'+esc((p.name||'NN').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase())+'</span>';
    const nm=document.getElementById('otherProfileName'); if(nm)nm.textContent=p.name;
    const loc=document.getElementById('otherProfileLocation'); if(loc)loc.textContent=(p.country?'🌍 '+p.country:'')+(p.city?' · 📍 '+p.city:'');
    const stats=document.querySelector('#s11 .nn-v25-profile-grid'); if(stats)stats.innerHTML='<div class="nn-v25-stat"><b>🗣️ Languages</b><span>'+esc((p.languages||[]).join(' · ')||'Not added yet')+'</span></div><div class="nn-v25-stat"><b>❤️ Interests</b><span>'+esc((p.interests||[]).join(' · ')||'Not added yet')+'</span></div>';
    const about=document.querySelector('#s11 .card'); if(about)about.innerHTML='<strong>About</strong><p class="sub">'+esc(p.intro||'This member has not added an introduction yet.')+'</p><div class="tag-row">'+(p.country?'<span class="tag">🌍 '+esc(p.country)+'</span>':'')+(p.city?'<span class="tag">📍 '+esc(p.city)+'</span>':'')+(p.what?'<span class="tag">✨ '+esc(p.what)+'</span>':'')+'</div>';
    const btn=document.getElementById('personConnectBtn'); if(btn){btn.textContent='Connect';btn.disabled=false;btn.style.opacity='';}
    go(11);
    nnLoadConnectionState();
  };
  async function nnLoadConnectionState(){
    const btn=document.getElementById('personConnectBtn'); if(!btn||!nnSelectedPerson)return;
    try{
      const me=await nnUser(); if(!me)return;
      const r=await supabaseClient.from('connections').select('id,status,requester_id,recipient_id').or('and(requester_id.eq.'+me.id+',recipient_id.eq.'+nnSelectedPerson.id+'),and(requester_id.eq.'+nnSelectedPerson.id+',recipient_id.eq.'+me.id+')').order('created_at',{ascending:false}).limit(1).maybeSingle();
      if(r.data){
        if(r.data.status==='accepted'){
          btn.textContent='Connected ✓';
          btn.disabled=true;
          btn.onclick=null;
          btn.style.opacity='.75';
        }else if(r.data.requester_id===me.id){
          btn.textContent='Request Sent';
          btn.disabled=true;
          btn.onclick=null;
          btn.style.opacity='.75';
        }else{
          // Incoming pending request: this button must remain clickable.
          btn.textContent='Respond in Connections';
          btn.disabled=false;
          btn.style.opacity='';
          btn.onclick=function(){window.nnOpenConnectionResponse(r.data.id,nnSelectedPerson.name)};
        }
      }
    }catch(e){}
  }
  window.nnConnectSelected=async function(){
    const b=document.getElementById('personConnectBtn'); if(!nnSelectedPerson)return;
    try{
      const me=await nnUser(); if(!me)throw new Error('Please sign in first.');
      b.disabled=true;b.textContent='Connecting…';
      const existing=await supabaseClient.from('connections').select('id,status').or('and(requester_id.eq.'+me.id+',recipient_id.eq.'+nnSelectedPerson.id+'),and(requester_id.eq.'+nnSelectedPerson.id+',recipient_id.eq.'+me.id+')').limit(1).maybeSingle();
      if(existing.error)throw existing.error;
      if(existing.data){b.textContent=existing.data.status==='accepted'?'Connected ✓':'Request Sent';b.style.opacity='.75';return}
      const r=await supabaseClient.from('connections').insert({requester_id:me.id,recipient_id:nnSelectedPerson.id,status:'pending'}).select().single();
      if(r.error)throw r.error;
      b.textContent='Request Sent ✓';b.style.opacity='.75';
    }catch(e){b.disabled=false;b.textContent='Connect';alert(e.message||'Could not send connection request.')}
  };

  async function nnFindConversation(meId,otherId){
    const a=await supabaseClient.from('conversation_members').select('conversation_id').eq('profile_id',meId);
    if(a.error)throw a.error;
    const mine=(a.data||[]).map(x=>x.conversation_id);
    if(!mine.length)return null;
    const b=await supabaseClient.from('conversation_members').select('conversation_id').eq('profile_id',otherId).in('conversation_id',mine);
    if(b.error)throw b.error;
    return b.data?.[0]?.conversation_id||null;
  }
  async function nnEnsureConversation(meId,otherId){
    const found=await nnFindConversation(meId,otherId); if(found)return found;
    const c=await supabaseClient.from('conversations').insert({}).select('id').single();
    if(c.error)throw c.error;
    const m=await supabaseClient.from('conversation_members').insert([{conversation_id:c.data.id,profile_id:meId},{conversation_id:c.data.id,profile_id:otherId}]);
    if(m.error)throw m.error;
    return c.data.id;
  }
  async function nnOpenRealChat(){
    if(!nnSelectedPerson){alert('Please choose a person first.');return}
    const me=await nnUser(); if(!me){alert('Please sign in first.');return}
    localStorage.setItem('nearNativeChatPerson',nnSelectedPerson.name);
    const h=document.getElementById('chatPersonName');if(h)h.textContent=nnSelectedPerson.name;
    nnChatConversationId=await nnEnsureConversation(me.id,nnSelectedPerson.id);
    go(16); await nnLoadChatMessages();
  }
  async function nnLoadChatMessages(){
    const box=document.getElementById('chatMessages'); if(!box||!nnChatConversationId)return;
    box.innerHTML='<p class="sub">Loading conversation…</p>';
    try{
      const r=await supabaseClient.from('messages').select('id,sender_id,message,created_at').eq('conversation_id',nnChatConversationId).order('created_at',{ascending:true});
      if(r.error)throw r.error;
      const me=await nnUser();
      if(!r.data?.length){box.innerHTML='<p class="sub" style="margin-top:14px">No messages yet. Start the conversation.</p>';return}
      box.innerHTML=r.data.map(m=>'<div class="card" style="margin-top:8px"><strong>'+esc(m.sender_id===me?.id?'You':(nnSelectedPerson?.name||'Member'))+'</strong><p class="sub" style="margin:5px 0 0">'+esc(m.message||'')+'</p></div>').join('');
    }catch(e){box.innerHTML='<p class="sub">Messages could not be loaded right now.</p>';}
  }
  window.sendMessage=async function(){
    const input=document.getElementById('messageInput'), msg=input?.value.trim(); if(!msg)return;
    try{
      const me=await nnUser(); if(!me)throw new Error('Please sign in first.');
      if(!nnSelectedPerson){
        const id=localStorage.getItem('nearNativePersonId'); nnSelectedPerson=nnPeopleCache.find(x=>x.id===id)||null;
      }
      if(!nnSelectedPerson)throw new Error('Choose a person from Discover first.');
      if(!nnChatConversationId)nnChatConversationId=await nnEnsureConversation(me.id,nnSelectedPerson.id);
      const r=await supabaseClient.from('messages').insert({conversation_id:nnChatConversationId,sender_id:me.id,message:msg}).select().single();
      if(r.error)throw r.error;
      input.value=''; await nnLoadChatMessages();
    }catch(e){alert(e.message||'Could not send message.')}
  };

  async function nnLoadMessages(){
    const host=document.getElementById('messagesList')||document.querySelector('#s15 .message-list');
    if(!host)return;
    try{
      const me=await nnUser(); if(!me)throw new Error('Please sign in.');
      const cm=await supabaseClient.from('conversation_members').select('conversation_id').eq('profile_id',me.id);
      if(cm.error)throw cm.error;
      const ids=(cm.data||[]).map(x=>x.conversation_id);
      if(!ids.length){host.innerHTML='<div class="card"><strong>No conversations yet</strong><p class="sub">When you connect with someone and start chatting, your conversations will appear here.</p></div>';return}
      const members=await supabaseClient.from('conversation_members').select('conversation_id,profile_id').in('conversation_id',ids);
      if(members.error)throw members.error;
      const otherIds=[...new Set((members.data||[]).filter(x=>x.profile_id!==me.id).map(x=>x.profile_id))];
      if(!otherIds.length){host.innerHTML='<div class="card"><strong>No conversations yet</strong></div>';return}
      const profiles=await supabaseClient.from('profiles').select('id,first_name,last_name,current_city,country').in('id',otherIds);
      if(profiles.error)throw profiles.error;
      const last=await supabaseClient.from('messages').select('conversation_id,message,created_at').in('conversation_id',ids).order('created_at',{ascending:false});
      const lastMap={}; if(!last.error)(last.data||[]).forEach(m=>{if(!lastMap[m.conversation_id])lastMap[m.conversation_id]=m});
      host.innerHTML=profiles.data.map(p=>{
        const cid=(members.data||[]).find(x=>x.profile_id===p.id)?.conversation_id; const name=[p.first_name,p.last_name].filter(Boolean).join(' ')||'Near-Native member'; const preview=lastMap[cid]?.content||'Start a conversation';
        return '<div class="card" style="cursor:pointer" onclick="nnOpenChatFromMessage('+JSON.stringify(p.id)+')"><strong>'+esc(name)+'</strong><p class="sub" style="margin:6px 0 0">'+esc(preview)+'</p><div class="small">'+esc(p.country||'')+(p.current_city?' · '+esc(p.current_city):'')+'</div></div>';
      }).join('');
    }catch(e){host.innerHTML='<div class="card"><strong>Messages unavailable</strong><p class="sub">'+esc(e.message||'Please try again.')+'</p></div>'}
  }
  window.nnOpenChatFromMessage=async function(id){
    if(!nnPeopleCache.length){await nnLoadPeople()}
    let p=nnPeopleCache.find(x=>x.id===id);
    if(!p){
      const r=await supabaseClient.from('profiles').select('id,first_name,last_name,country,current_city,bio,profile_photo_url,what_you_want').eq('id',id).single();
      if(r.error)throw r.error;p={id:r.data.id,name:[r.data.first_name,r.data.last_name].filter(Boolean).join(' ')||'Near-Native member',country:r.data.country||'',city:r.data.current_city||'',intro:r.data.bio||'',photo:r.data.profile_photo_url||'',what:r.data.what_you_want||''};nnPeopleCache.push(p);
    }
    nnSelectedPerson=p; await nnOpenRealChat();
  };

  function nnCommunityDiscoverLink(){
    const el=document.getElementById('discoverCommunity'); if(!el)return;
    const p=nnProfile(), c=p.city||city, co=p.country||country;
    el.textContent=(co==='South Africa'?'South Africans':'People from '+co)+' in '+c;
  }

  /* Replace demo People/Profile/Messages UI with data-driven UI while preserving the V2.5.4 visual design. */
  function nnPrepareScreens(){
    const s11=document.getElementById('s11');
    if(s11){
      const actions=s11.querySelector('.profile-actions');
      if(actions)actions.innerHTML='<button id="personConnectBtn" class="btn primary" style="margin:0" onclick="nnConnectSelected()">🤝 Connect</button><button class="btn secondary" style="margin:0" onclick="nnOpenRealChat()">💬 Message</button>';
      const banner=s11.querySelector('.connection-banner'); if(banner)banner.textContent='🤝 Connect with people who share your city, country, languages or interests.';
    }
