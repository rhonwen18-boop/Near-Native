async function signIn(){
  const email=document.getElementById('signupEmail').value.trim();
  const password=document.getElementById('signupPassword').value;
  const btn=document.getElementById('signupBtn');
  if(!email||!password){setAuthStatus('Enter your email and password.',true);return}
  btn.disabled=true; btn.textContent='Signing in…';
  try{
    const {data,error}=await supabaseClient.auth.signInWithPassword({email,password});
    if(error) throw error;
    localStorage.setItem('nearNativeAuth','true');
    localStorage.setItem('nearNativeEmail',email);
    // V2.6: load this user's Supabase profile before onboarding so one account
    // can never inherit another account's local country/city/profile data.
    if(data?.user && typeof window.nnHydrateProfile==='function') await window.nnHydrateProfile(data.user);
    if(data?.user && typeof window.nnEnsureProfileForCurrentUser==='function') await window.nnEnsureProfileForCurrentUser(data.user);
    setAuthStatus('Signed in successfully.');
    setTimeout(()=>go(3),500);
  }catch(err){
    setAuthStatus(err.message||'We could not sign you in.',true);
    btn.disabled=false; btn.textContent='Sign In';
  }
}
async function createAccount(){
  const name=document.getElementById('signupName').value.trim();
  const email=document.getElementById('signupEmail').value.trim();
  const password=document.getElementById('signupPassword').value;
  const btn=document.getElementById('signupBtn');
  if(!name||!email||!password){setAuthStatus('Please enter your name, email and password.',true);return}
  if(password.length<6){setAuthStatus('Your password must be at least 6 characters.',true);return}
  btn.disabled=true; btn.textContent='Creating account…';
  try{
    const {data,error}=await supabaseClient.auth.signUp({
      email,password,
      options:{data:{first_name:name}}
    });
    if(error) throw error;

    // V2.6: a new account starts with a completely clean local profile.
    // Never carry the previous user's country/city/name into this account.
    localStorage.removeItem('nearNativeMapCity');
    localStorage.removeItem('nearNativePerson');
    localStorage.removeItem('nearNativeChatPerson');
    Object.keys(localStorage).filter(k=>k.startsWith('nearNativeMessage_')).forEach(k=>localStorage.removeItem(k));
    country=''; city='';
    Object.keys(state).forEach(k=>delete state[k]);
    state.name=name;
    const freshProfile={country:'',city:'',name,intro:'',languages:[],interests:[]};
    localStorage.setItem('nearNativeEmail',email);
    localStorage.setItem('nearNativeProfile',JSON.stringify(freshProfile));

    if(data.session && data.user){
      localStorage.setItem('nearNativeAuth','true');
      // Create the profile row immediately when Supabase gives us a session.
      // The onboarding fields will update this same row as the user proceeds.
      if(typeof window.nnEnsureProfileForCurrentUser==='function') await window.nnEnsureProfileForCurrentUser(data.user,{first_name:name});
      setAuthStatus('Account created. Your Near-Native profile is ready.');
      setTimeout(()=>go(3),500);
    }else{
      setAuthStatus('Account created. Check your email to confirm your account, then sign in to continue.');
      setTimeout(()=>showLogin(),1200);
    }
  }catch(err){
    setAuthStatus(err.message||'We could not create the account. Please try again.',true);
    btn.disabled=false; btn.textContent='Create Account';
  }
}

