<div id="nnConnectionModal" class="nn-connection-modal" onclick="if(event.target===this)nnCloseConnectionResponse()">
  <div class="nn-connection-sheet">
    <div class="eyebrow">CONNECTION REQUEST</div>
    <h2 id="nnConnectionModalTitle">Connection request</h2>
    <p id="nnConnectionModalText" class="sub">Someone wants to connect with you.</p>
    <div id="nnConnectionModalStatus" class="connection-banner">🤝 Review this connection request.</div>
    <div class="nn-connection-actions">
      <button type="button" class="btn secondary" onclick="nnRespondConnection('declined')">Decline</button>
      <button type="button" class="btn primary" onclick="nnRespondConnection('accepted')">Accept</button>
    </div>
    <button type="button" class="link" style="width:100%;margin-top:8px" onclick="nnCloseConnectionResponse()">Not now</button>
  </div>
</div>
<script>
/* V2.6.3 — real incoming connection response */
(function(){
  let pendingConnectionId=null;
  window.nnOpenConnectionResponse=function(connectionId,personName){
    pendingConnectionId=String(connectionId||'');
    const modal=document.getElementById('nnConnectionModal');
    const title=document.getElementById('nnConnectionModalTitle');
    const text=document.getElementById('nnConnectionModalText');
    const status=document.getElementById('nnConnectionModalStatus');
    if(!modal||!pendingConnectionId)return;
    if(title)title.textContent='Connect with '+(personName||'this person')+'?';
    if(text)text.textContent=(personName||'This person')+' sent you a connection request.';
    if(status)status.textContent='🤝 Accept to connect. You can then start messaging.';
    modal.classList.add('open');
  };
  window.nnCloseConnectionResponse=function(){
    pendingConnectionId=null;
    document.getElementById('nnConnectionModal')?.classList.remove('open');
  };
  window.nnRespondConnection=async function(newStatus){
    if(!pendingConnectionId)return;
    const modal=document.getElementById('nnConnectionModal');
    const buttons=modal?.querySelectorAll('.nn-connection-actions .btn');
    buttons?.forEach(b=>b.disabled=true);
    try{
      const me=await nnUser();
      if(!me)throw new Error('Please sign in first.');
      const r=await supabaseClient.from('connections')
        .update({status:newStatus})
        .eq('id',pendingConnectionId)
        .eq('recipient_id',me.id)
        .eq('status','pending')
        .select('id,status')
        .single();
      if(r.error)throw r.error;
      nnCloseConnectionResponse();
      const btn=document.getElementById('personConnectBtn');
      if(btn){
        if(newStatus==='accepted'){
          btn.textContent='Connected ✓';
          btn.disabled=true;
          btn.style.opacity='.75';
          btn.onclick=null;
        }else{
          btn.textContent='Connect';
          btn.disabled=false;
          btn.style.opacity='';
          btn.onclick=function(){window.nnConnectSelected()};
        }
      }
      alert(newStatus==='accepted'?'Connection accepted ✓':'Connection declined.');
    }catch(e){
      buttons?.forEach(b=>b.disabled=false);
      alert(e.message||'Could not update this connection request.');
    }
  };
})();
</script>
</body></html>
